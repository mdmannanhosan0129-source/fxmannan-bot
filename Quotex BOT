    <div class="label">ASSET CATEGORY</div>
    <select id="catSelect" onchange="loadOptions()">
      <option value="currencies">Currencies (Forex Pairs)</option>
      <option value="crypto">Crypto (Binance/Crypto)</option>
      <option value="commodities">Commodities (Gold/Silver)</option>
      <option value="stocks">Stocks & Indices</option>
    </select>

    <div class="label">SEARCH & SELECT PAIR</div>
    <input type="text" id="pairSearch" placeholder=" Search pair (e.g. EUR, Gold, BDT)..." onkeyup="filterPairs()">
    <select id="pairSelect" size="4" onchange="onPairChange()" style="height: 95px;"></select>

    <div class="label">TIMEFRAME / EXPIRY</div>
    <select id="tfSelect"></select>

    <button class="gen-btn" onclick="startScanner()">SCAN MULTI-API MARKET & GET SIGNAL</button>

    <div id="scannerAlert" class="scanner-alert">
       Scanning real-time API feed & 99% win-rate window... (<span id="scanSec">3</span>s)
    </div>

    <div id="resultCard" class="result-box">
      <div style="font-size: 10px; color: #d1d5db;" id="sigId">SIGNAL ID #FX9921</div>
      <div id="sigText" class="signal-title">FXMANNAN BUY </div>
      <div style="font-size: 11px; color: #fbbf24; font-weight: bold;" id="sigMode">STRATEGY: NEXT CANDLE ENTRY</div>

      <div class="timing-highlight" id="timingWindowBox">
         REAL-TIME ENTRY GUIDE: Loading...
      </div>

      <div class="market-analysis">
        <div style="font-weight: bold; color: #38bdf8; margin-bottom: 4px; text-align: center;" id="analysisTitle"> MULTI-API TECHNICAL ANALYSIS</div>
        <div class="analysis-row">
          <span>Live Price Feed:</span> <b id="resLivePrice" style="color: #4ade80;">1.11218</b>
