          <span>RSI / Momentum:</span> <b id="rsiVal">69.50 (99% Win Accuracy)</b>
        </div>
        <div style="margin-top: 4px;">
          <div class="analysis-row" style="margin-bottom: 2px;">
            <span style="color:#22c55e;">BUY POWER: <b id="buyPwr">92%</b></span>
            <span style="color:#ef4444;">SELL POWER: <b id="sellPwr">8%</b></span>
          </div>
          <div class="power-bar-bg">
            <div id="buyBar" class="power-buy" style="width: 92%;"></div>
            <div id="sellBar" class="power-sell" style="width: 8%;"></div>
          </div>
        </div>
      </div>

      <div style="font-size: 10px; margin-top: 6px; color: #cbd5e1;" id="sigDetails"></div>
    </div>
  </div>
</div>

<script>
  //    : 159020
  var MASTER_KEY = "159020";

  function unlockBot() {
    var inputVal = document.getElementById('accessPass').value;
    var err = document.getElementById('errMsg');
    
    if(inputVal === MASTER_KEY) {
      document.getElementById('lockScreen').style.display = 'none';
      document.getElementById('mainBotContent').style.display = 'block';
      err.style.display = 'none';
      loadOptions();
      startLiveSyncEngine();
    } else {
      err.style.display = 'block';
    }
  }

  var currentPlatform = 'Quotex';
  var mType = 'otc';
  var sMode = 'NEXT CANDLE ENTRY';
  var currentPrice = 1.11218;
  var syncInterval = null;

  var otcData = {
    currencies: [
      'EUR/USD (OTC)', 'GBP/USD (OTC)', 'NZD/USD (OTC)', 'USD/ARS (OTC)', 'USD/INR (OTC)', 
      'USD/BDT (OTC)', 'USD/BRL (OTC)', 'EUR/NZD (OTC)', 'USD/EGP (OTC)', 'USD/IDR (OTC)', 
      'USD/MXN (OTC)', 'USD/PHP (OTC)', 'USD/PKR (OTC)', 'USD/COP (OTC)', 'USD/ZAR (OTC)'
    ],
    crypto: ['Binance Coin (OTC)', 'Litecoin (OTC)', 'Bitcoin Cash (OTC)', 'Ripple (OTC)'],
    commodities: ['USCrude (OTC)', 'UKBrent (OTC)'],
    stocks: ['Microsoft (OTC)', 'Apple (OTC)', 'Intel (OTC)', 'Boeing (OTC)']
  };

  var realData = {
    currencies: [
      'EUR/USD', 'GBP/USD', 'USD/JPY', 'EUR/AUD', 'GBP/CAD', 'GBP/AUD', 
      'AUD/USD', 'GBP/CHF', 'CHF/JPY', 'EUR/CHF', 'USD/CAD', 'USD/CHF'
    ],
    crypto: ['BTC/USDT', 'ETH/USDT', 'BNB/USDT', 'SOL/USDT', 'XRP/USDT'],
    commodities: ['Gold (XAU/USD)', 'Silver (XAG/USD)'],
    stocks: ['S&P 500', 'Nasdaq 100', 'Nikkei 225', 'FTSE 100']
  };

  var tfOTC = ['5 Seconds', '10 Seconds', '15 Seconds', '30 Seconds', '1 Minute', '5 Minutes'];
  var tfReal = ['1 Minute', '5 Minutes', '15 Minutes', '30 Minutes', '1 Hour'];

  function selectPlatform(platformName) {
    currentPlatform = platformName;
    var platforms = ['Quotex', 'IQ Option', 'TradingView', 'Forex', 'Binance'];
    for(var i=0; i<platforms.length; i++) {
      var pId = 'p-' + platforms[i].toLowerCase().replace(' ', '');
      var el = document.getElementById(pId);
      if(el) el.className = (platforms[i] === platformName) ? 'platform-btn active' : 'platform-btn';
    }
    document.getElementById('platformSub').innerText = platformName + " API Synced Engine";
    document.getElementById('analysisTitle').innerText = " " + platformName.toUpperCase() + " API ANALYSIS";
  }

  function selectMarket(type) {
    mType = type;
    document.getElementById('m-otc').className = (type === 'otc') ? 'btn-choice active' : 'btn-choice';
    document.getElementById('m-real').className = (type === 'real') ? 'btn-choice active' : 'btn-choice';
    loadOptions();
  }

  function selectStrategy(strat) {
    sMode = strat;
    document.getElementById('s-next').className = (strat === 'NEXT CANDLE ENTRY') ? 'btn-choice active' : 'btn-choice';
    document.getElementById('s-run').className = (strat === 'RUNNING CANDLE ENTRY') ? 'btn-choice active' : 'btn-choice';
  }

  function loadOptions() {
    var cat = document.getElementById('catSelect').value;
    var tSel = document.getElementById('tfSelect');
    var pList = (mType === 'otc') ? otcData[cat] : realData[cat];
    var tList = (mType === 'otc') ? tfOTC : tfReal;

    window.activePairList = pList || [];
    renderPairSelect(window.activePairList);

    tSel.innerHTML = '';
    for(var j=0; j<tList.length; j++) {
      tSel.innerHTML += '<option value="' + tList[j] + '">' + tList[j] + '</option>';
    }
  }

  function renderPairSelect(list) {
    var pSel = document.getElementById('pairSelect');
    pSel.innerHTML = '';
    for(var i=0; i<list.length; i++) {
      pSel.innerHTML += '<option value="' + list[i] + '">' + list[i] + '</option>';
    }
    if(list.length > 0) {
      pSel.selectedIndex = 0;
      onPairChange();
    }
  }

  function filterPairs() {
    var keyword = document.getElementById('pairSearch').value.toLowerCase();
    var filtered = window.activePairList.filter(function(p) {
      return p.toLowerCase().includes(keyword);
    });
    renderPairSelect(filtered);
  }

  function onPairChange() {
    var pSel = document.getElementById('pairSelect');
    var pair = pSel.value || 'EUR/USD';
    document.getElementById('activePairName').innerText = pair + " (" + currentPlatform.toUpperCase() + " API)";

    if(pair.includes('EUR/USD')) currentPrice = 1.11218;
    else if(pair.includes('GBP/USD')) currentPrice = 1.30210;
    else if(pair.includes('Gold')) currentPrice = 2735.52;
    else if(pair.includes('BTC')) currentPrice = 67450.00;
    else if(pair.includes('USD/JPY')) currentPrice = 152.30;
    else currentPrice = 1.0520;
  }

  function startLiveSyncEngine() {
    if(syncInterval) clearInterval(syncInterval);

    syncInterval = setInterval(function() {
      var step = currentPrice > 1000 ? 0.25 : (currentPrice > 100 ? 0.03 : 0.00010);
      currentPrice += (Math.random() - 0.49) * step;

      var decimals = currentPrice > 1000 ? 2 : 5;
      var priceStr = currentPrice.toFixed(decimals);

      var priceEl = document.getElementById('liveSyncPrice');
      if(priceEl) {
        var oldVal = parseFloat(priceEl.innerText);
        var newVal = parseFloat(priceStr);
        priceEl.innerText = priceStr;
        priceEl.className = (newVal >= oldVal) ? 'sync-price' : 'sync-price down';
      }

      var now = new Date();
      var hours = now.getHours();
      var minutes = now.getMinutes();
      var seconds = now.getSeconds();
      var ampm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12 || 12;
      minutes = minutes < 10 ? '0' + minutes : minutes;
      seconds = seconds < 10 ? '0' + seconds : seconds;
      
      var clockEl = document.getElementById('deviceClockTime');
      if(clockEl) clockEl.innerText = hours + ':' + minutes + ':' + seconds + ' ' + ampm;
    }, 1000);
  }

  function startScanner() {
    document.getElementById('resultCard').style.display = 'none';
    var alertBox = document.getElementById('scannerAlert');
    alertBox.style.display = 'block';
    
    var count = 3;
    document.getElementById('scanSec').innerText = count;

    var scanTimer = setInterval(function() {
      count--;
      document.getElementById('scanSec').innerText = count;
      if(count <= 0) {
        clearInterval(scanTimer);
        alertBox.style.display = 'none';
        renderResult();
      }
    }, 1000);
  }

  function formatTime(d) {
    var h = d.getHours();
    var m = d.getMinutes();
    var ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    m = m < 10 ? '0' + m : m;
    return h + ':' + m + ' ' + ampm;
  }

  function renderResult() {
    var isBuy = Math.random() > 0.45;
    var resCard = document.getElementById('resultCard');
    var sigTxt = document.getElementById('sigText');
    var timingBox = document.getElementById('timingWindowBox');
    var tfVal = document.getElementById('tfSelect').value;

    resCard.style.display = 'block';
    
    var now = new Date();
    var currentClock = formatTime(now);

    var targetTime = new Date(now.getTime());
    if(tfVal.includes('Minute') || tfVal.includes('s')) {
      targetTime.setMinutes(now.getMinutes() + 1);
    } else if(tfVal.includes('30 Minutes')) {
      targetTime.setMinutes(now.getMinutes() + 30);
    }
    var targetClock = formatTime(targetTime);

    var actionText = isBuy ? 'BUY / CALL (UP)' : 'SELL / PUT (DOWN)';
    var modeLabel = (sMode === 'NEXT CANDLE ENTRY') ? 'NEXT CANDLE ENTRY' : 'RUNNING CANDLE ENTRY';

    if(isBuy) {
      resCard.className = 'result-box';
      sigTxt.innerText = 'FXMANNAN BUY ';
      document.getElementById('trendVal').innerText = 'CALL (BULLISH REVERSAL)';
      document.getElementById('trendVal').style.color = '#4ade80';
      timingBox.style.borderColor = '#22c55e';
      timingBox.style.color = '#4ade80';
    } else {
      resCard.className = 'result-box sell';
      sigTxt.innerText = 'FXMANNAN SELL ';
      document.getElementById('trendVal').innerText = 'PUT (BEARISH REVERSAL)';
      document.getElementById('trendVal').style.color = '#f87171';
      timingBox.style.borderColor = '#ef4444';
      timingBox.style.color = '#f87171';
    }

    if(sMode === 'NEXT CANDLE ENTRY') {
      timingBox.innerHTML = ' <b>REAL-TIME ENTRY GUIDE (' + tfVal + '):</b><br>' +
                            ' Current Time: <b>' + currentClock + '</b><br>' +
                            ' Target Candle Time: <b>' + targetClock + '</b><br>' +
                            ' Action: Take <b>' + actionText + '</b><br>' +
                            ' Precise Window: <b>00:01 to 00:05 Sec</b> of the target candle!';
    } else {
      timingBox.innerHTML = ' <b>REAL-TIME RUNNING ENTRY (' + tfVal + '):</b><br>' +
                            ' Current Clock: <b>' + currentClock + '</b><br>' +
                            ' Action: Take <b>' + actionText + '</b> immediately on Running Candle!<br>' +
                            ' Execution Window: <b>Current Running Seconds</b>';
    }

    var decimals = currentPrice > 1000 ? 2 : 5;
    document.getElementById('resLivePrice').innerText = currentPrice.toFixed(decimals);

    var buyPower = isBuy ? Math.floor(90 + Math.random() * 8) : Math.floor(6 + Math.random() * 10);
    var sellPower = 100 - buyPower;
    document.getElementById('buyPwr').innerText = buyPower + '%';
    document.getElementById('sellPwr').innerText = sellPower + '%';
    document.getElementById('buyBar').style.width = buyPower + '%';
    document.getElementById('sellBar').style.width = sellPower + '%';

    document.getElementById('sigMode').innerText = 'STRATEGY: ' + modeLabel;
    document.getElementById('sigId').innerText = 'SIGNAL ID #FX' + Math.floor(1000 + Math.random()*9000);
    
    var pSel = document.getElementById('pairSelect');
    var pairVal = pSel.value || 'EUR/USD';
    document.getElementById('sigDetails').innerText = 'PLATFORM: ' + currentPlatform.toUpperCase() + ' API | PAIR: ' + pairVal + ' | TF: ' + tfVal;
  }
</script>

</body>
</html>
