  .platform-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; margin-bottom: 10px; }
  .platform-btn { padding: 8px 2px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; color: #94a3b8; font-size: 10px; font-weight: bold; cursor: pointer; text-align: center; }
  .platform-btn.active { background: #0284c7; color: #ffffff; border-color: #38bdf8; }

  .live-sync-box { background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 10px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
