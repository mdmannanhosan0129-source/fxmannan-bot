  <!-- MAIN DASHBOARD -->
  <div id="mainBotContent">
    <div class="label">SELECT API PLATFORM</div>
    <div class="platform-grid">
      <div id="p-quotex" class="platform-btn active" onclick="selectPlatform('Quotex')">Quotex API</div>
      <div id="p-iq" class="platform-btn" onclick="selectPlatform('IQ Option')">IQ Option</div>
