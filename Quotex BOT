    </div>

    <div class="live-sync-box">
      <div>
        <div class="sync-label" id="activePairName">EUR/USD LIVE FEED</div>
        <div class="sync-price" id="liveSyncPrice">1.11218</div>
      </div>
      <div style="text-align: right;">
        <div class="sync-label">REAL DEVICE CLOCK</div>
        <div style="font-size: 14px; color: #fbbf24; font-weight: bold;" id="deviceClockTime">00:00:00</div>
      </div>
    </div>

    <div class="label">MARKET TYPE</div>
