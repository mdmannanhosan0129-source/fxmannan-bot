  .label { font-size: 11px; color: #94a3b8; margin-top: 8px; margin-bottom: 3px; font-weight: bold; }
  .btn-grid { display: flex; gap: 6px; margin-bottom: 6px; }
  .btn-choice { flex: 1; padding: 8px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; color: #94a3b8; font-size: 11px; font-weight: bold; cursor: pointer; text-align: center; }
  .btn-choice.active { background: #0284c7; color: #ffffff; border-color: #38bdf8; }
  
  select, input { width: 100%; padding: 9px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; color: #ffffff; font-size: 13px; outline: none; margin-bottom: 6px; font-weight: bold; }
  
  .gen-btn { width: 100%; padding: 13px; background: linear-gradient(135deg, #2563eb, #1d4ed8); border: none; border-radius: 8px; color: white; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 8px; box-shadow: 0 4px 12px rgba(37,99,235,0.4); }
  
  .scanner-alert { display: none; background: #7c2d12; border: 1px solid #f97316; color: #ffedd5; padding: 10px; border-radius: 6px; text-align: center; font-size: 12px; font-weight: bold; margin-top: 10px; }
  
  .result-box { display: none; background: #064e3b; border: 2px solid #10b981; border-radius: 10px; padding: 12px; text-align: center; margin-top: 10px; }
  .result-box.sell { background: #7f1d1d; border-color: #ef4444; }
  .signal-title { font-size: 24px; font-weight: bold; margin: 4px 0; }
  
  .timing-highlight { background: rgba(0,0,0,0.6); border: 1px dashed #fbbf24; border-radius: 6px; padding: 10px; margin: 8px 0; color: #fbbf24; font-size: 11px; font-weight: bold; text-align: left; line-height: 1.6; }
  
  .market-analysis { background: rgba(0,0,0,0.5); border: 1px solid #334155; border-radius: 6px; padding: 8px; margin-top: 8px; text-align: left; font-size: 10px; }
  .analysis-row { display: flex; justify-content: space-between; margin-bottom: 4px; }
  .power-bar-bg { background: #374151; height: 6px; border-radius: 3px; overflow: hidden; display: flex; margin-top: 2px; }
  .power-buy { background: #22c55e; height: 100%; }
  .power-sell { background: #ef4444; height: 100%; }
